# Base URL of awanin-server (see ./server).
#
# Copy this file to .env and adjust when the API does not run on localhost:
#   - web / iOS simulator:      http://localhost:4000
#   - Android emulator:         http://10.0.2.2:4000
#   - physical phone (Expo Go): http://<your-computer-LAN-IP>:4000
#
# Leave it empty to run the app in direct mode: every request goes straight to
# Open-Meteo and server-side push/subscriptions are skipped.
EXPO_PUBLIC_API_URL=http://localhost:4000
