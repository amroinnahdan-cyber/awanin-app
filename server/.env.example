# Port the API listens on
PORT=4000

# SQLite file. ":memory:" is used by the tests.
DATABASE_PATH=./data/awanin.db

# Comma-separated allowed origins ("*" for any). The Expo web preview runs on
# http://localhost:8081, so keep localhost in this list during development.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# How often the scheduler polls Open-Meteo and evaluates alerts (minutes)
POLL_INTERVAL_MINUTES=15

# Minimum gap between two alerts for the same device (minutes)
COOLDOWN_MINUTES=180

# Default quiet hours in Asia/Jakarta (HH:MM, 24h). Devices can override.
QUIET_START=22:00
QUIET_END=06:00

# Optional: Expo access token from https://expo.dev/accounts/<account>/settings/access-tokens
# Only needed when "Enhanced security for push notifications" is enabled.
EXPO_ACCESS_TOKEN=

LOG_LEVEL=info
